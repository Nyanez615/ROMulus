#!/usr/bin/env bash
# Wipe Rust build artifacts after every push to keep disk usage in check.
# The next `cargo build` / `npm run tauri dev` will be a cold compile.
set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TARGET_DIR="$SCRIPT_DIR/../src-tauri/target"
if [ -d "$TARGET_DIR" ]; then
  echo "🧹 Cleaning Rust build artifacts…"
  (cd "$SCRIPT_DIR/../src-tauri" && cargo clean)
fi
